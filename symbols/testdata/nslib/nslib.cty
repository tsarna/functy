// A namespaced symbol library: everything lives in namespace acme::net, so a
// binding block must select it with `namespace = "acme::net"`.

namespace acme::net

type cidr = string

// A namespace-local (private) type: resolved and usable within acme::net, but
// withheld from the exported symbol surface.
type _octet = number

func mask(s: string) -> string {
    return upper(s)
}

const default_cidr = "10.0.0.0/8"
